#!/usr/bin/env python3
"""slotfather: one queue of leases on the machine's capacity, shared by every project and agent (#599).

  slotfather run [-n N|all] [--label L] [--wait S] [--] COMMAND...   run COMMAND holding N slots (default 1)
  slotfather status                                                  holders and waiters, in queue order
  slotfather history [N]                                             the last N requests that left the queue
  slotfather stats [--since W] [--label L] [--by B] [--json]         what leases used and how full the machine was
  slotfather slots [N|reset]                                           show, save or reset shared capacity
  slotfather available                                               slots a new request gets at once
  slotfather advise [--max N] [--exclusive]                          a job count for the load, as JSON
  slotfather [dashboard [--interval S | --once]]                     live view of capacity, leases and queue

Run heavy builds and tests through `slotfather run -n <k> -- ...`: a test suite or build that keeps the
machine busy takes 1 to 2 slots, a full gate that must not share the machine takes `-n all`.

Slots: one per three cores, at least one, so `total = max(1, cores // 3)`: 4 on a 12-core M2 Max.
`slotfather slots N` saves shared capacity; `slotfather slots reset` restores the automatic default.
SLOTFATHER_CORES replaces the core count. A request above the total takes every slot.

Requests are served in arrival order. A waiter that does not fit lets later requests that fit start before it until
it has waited SLOTFATHER_OVERTAKE_WINDOW seconds (default 600). Past that it is the head (#643, SLOTFATHER_QUEUE=
backfill, the default): a later request that fits still starts first if, by the run times of earlier requests of its
kind in the history, three times its expected run ends before the head can start (when the held leases are expected
to end) and before the head has waited SLOTFATHER_BACKFILL_LIMIT seconds (default 2700). An all-slot request
therefore starts at most that limit plus the longest run admitted meanwhile after it queued. SLOTFATHER_QUEUE=window
restores the earlier order, where the head holds back everyone behind it. A process that already runs under a
lease (SLOTFATHER_LEASE, or a holder among its ancestors) runs without a second lease, so nested wrappers neither
deadlock nor count twice. A lease whose
holder died (its pid gone, or reused by a process with another start time) is reaped by the next queue
operation. While memory is short (free swap under SLOTFATHER_MIN_FREE_SWAP_MB, default 512, where swap is on; or the
kernel's memory-pressure level at warning or above), new leases wait for running ones; with nothing running they
start. A waiter checks its own entry every SLOTFATHER_POLL seconds (default 2) but looks over the queue, which runs
ps, less often the longer nothing changes, up to SLOTFATHER_POLL_MAX (default 10); a release hands its slots on at
once. `--wait S` gives up after S seconds with exit 75 and leaves the queue. `run` exits with the command's status
(128 + the signal when a signal ended it).

`advise` sizes work for processes that take no lease: with each slot `cores / total` cores, the current load,
min(load1, load5), less what the held slots account for, max(0, load - held x cores per slot), is load without a
lease. Not load15: it still holds work whose leases ended minutes ago, and min() ignores a one-minute spike.
The job count is the slots left after that load (and after the held slots, unless --exclusive: an all-slot
request waits for them), a slot counting while at least half its cores are idle, never above --max (default
the total) nor, without --exclusive, the free slots, and at least 1. SLOTFATHER_LOADAVG replaces the load
averages: "load1 load5 load15", or one number for all three.

State: ~/.local/state/slotfather (SLOTFATHER_DIR replaces it; queue.log records grants, releases and
reaps; history.jsonl, which `history` lists, has a line per request that left the queue: its command, directory,
wait, run and outcome, and for `run` what its process tree used; machine.jsonl samples the machine while leases
run; `stats` reads both). While its command runs, the holder looks at the command's process tree every
SLOTFATHER_SAMPLE_MAX seconds at most (default 10; the first look comes sooner): CPU time is the command's own
rusage, which holds every descendant reaped inside the tree, plus the sampled CPU of processes that left the tree
(orphans, and launchd children carrying the lease's SLOTFATHER_LEASE). Held leases in the queues listed in
SLOTFATHER_LEGACY_DIRS (colon-separated; default Straylight's earlier ~/.local/state/straylight-verification/slots;
empty to ignore) count as used, scaled from their 4 slots, until their holders exit. SLOTFATHER_POLICY: normal
(default), background (low QoS), or bypass (no lease; for a person who knows the machine is idle). Standard library
only, Python 3.9 or later: install.py puts it, slotfather-dashboard and slotfather-stats, which `slotfather
dashboard` and `slotfather stats` run from beside it, in ~/.local/bin.
"""
from __future__ import annotations

import contextlib
import datetime
import fcntl
import json
import math
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import threading
import time

MIN_PYTHON = (3, 9)
if sys.version_info < MIN_PYTHON:
    sys.exit(f"slotfather needs Python {MIN_PYTHON[0]}.{MIN_PYTHON[1]} or later, not {sys.version.split()[0]} at "
             f"{sys.executable}; reinstall with a newer one: /path/to/python3 install.py")

DEFAULT_DIR = "~/.local/state/slotfather"
DEFAULT_LEGACY_DIRS = "~/.local/state/straylight-verification/slots"
LEGACY_TOTAL = 4  # the earlier queue's fixed slot count
CORES_PER_SLOT = 3
MIN_FREE_SWAP_MB = 512
MAX_PRESSURE_LEVEL = 1  # kern.memorystatus_vm_pressure_level: 1 normal, 2 warning, 4 critical
POLICIES = ("normal", "background", "bypass")
TIMED_OUT = 75  # EX_TEMPFAIL
POLL_MAX = 10  # seconds between a long waiter's full looks at the queue
OVERTAKE_WINDOW = 600  # seconds a waiter that does not fit lets later requests that fit start first
QUEUE_ORDERS = ("backfill", "window")  # SLOTFATHER_QUEUE; the first is the default
BACKFILL_FALLBACK = 3600  # seconds a request with no run like it in the history is expected to run
BACKFILL_SAFETY = 3.0  # a request passes the head only if this many times its estimate ends before the head starts
BACKFILL_OVERRUN = 0.5  # a held lease past its estimate runs on for this share of what it has run
BACKFILL_LIMIT = 2700  # seconds after the head queued from which nothing passes it, as in the window order (0: never)
ESTIMATE_RUNS = 20  # recent runs of a kind its estimate takes the median of
ESTIMATE_BYTES = 1 << 20  # of the history's end (and of its rotated part) read for estimates
HISTORY_MAX = 4 << 20  # bytes of history.jsonl; past it the file becomes history.jsonl.1, replacing the older one
# history.jsonl lines: version 1 had no "v" field and no usage; version 2 adds "v", what a `run` used (cpu,
# cpu_detached, wall, rss_peak_mb, rss_mean_mb, processes, samples) and the machine's cores and capacity.
HISTORY_VERSION = 2
MACHINE_VERSION = 1  # machine.jsonl lines
MACHINE_MAX = 4 << 20  # bytes of machine.jsonl before it becomes machine.jsonl.1
MACHINE_EVERY = 15  # seconds between machine samples while any lease runs
SAMPLE_FIRST = 0.5  # seconds before a holder's first look at its command's process tree
SAMPLE_MAX = 10  # longest interval between those looks; each is half as long again as the one before
PS_TIMEOUT = 5  # seconds a ps or sysctl of the sampler may take before its answer is given up
WATCH_JOIN = 5  # seconds a release waits for the sampler to stop, and for its lock; then it goes without
ALL_NOTE = ("-n all holds every later request behind it until the whole machine is free; use it only for work that "
            "needs the machine to itself, such as a performance measurement, and otherwise ask for the slots the "
            "command uses")
# The variables a lease hands its command; a client may add its own prefix (Straylight's STRAYLIGHT_SLOT_).
LEASE_ENV_PREFIXES = ["SLOTFATHER_"]


class SlotError(Exception):
    pass


class SlotTimeout(SlotError):
    pass


# Configuration

def setting(name: str, default: str | None = None) -> str | None:
    """SLOTFATHER_<name>, read when needed; a client that loads this file may replace this function to add its own
    spellings (tools/slot_lease.py)."""
    value = os.environ.get("SLOTFATHER_" + name)
    return default if value is None else value


def state_dir() -> Path:
    return Path(os.path.expanduser(setting("DIR") or DEFAULT_DIR))


def cores() -> int:
    value = setting("CORES") or ""
    return int(value) if value.isdigit() and int(value) > 0 else os.cpu_count() or 1


def capacity() -> tuple[int, bool]:
    """The shared saved capacity, or the automatic default; atomic publication keeps readers consistent."""
    path = state_dir() / "capacity.json"
    try:
        value = json.loads(path.read_text())["slots"]
    except FileNotFoundError:
        return max(1, cores() // CORES_PER_SLOT), False
    except (OSError, ValueError, KeyError, TypeError) as error:
        raise SlotError(f"cannot read capacity from {path}: {error}") from None
    if type(value) is not int or value < 1:
        raise SlotError(f"invalid saved capacity in {path}; use slotfather slots reset while the queue is idle")
    return value, True


def total() -> int:
    return capacity()[0]


def loads() -> tuple[float, float, float]:
    """The 1, 5 and 15-minute load averages."""
    value = (setting("LOADAVG") or "").split()
    with contextlib.suppress(ValueError):
        if len(value) == 1:
            return (float(value[0]),) * 3
        if len(value) == 3:
            return tuple(float(v) for v in value)
    return os.getloadavg()


def overtake_window() -> float:
    """SLOTFATHER_OVERTAKE_WINDOW in seconds; a value that is not a number serves strictly in order."""
    try:
        return max(0.0, float(setting("OVERTAKE_WINDOW") or OVERTAKE_WINDOW))
    except ValueError:
        return 0.0


def legacy_dirs() -> list[Path]:
    value = setting("LEGACY_DIRS", DEFAULT_LEGACY_DIRS)
    own = state_dir().resolve()
    paths = [Path(os.path.expanduser(p)) for p in value.split(":") if p]
    return [p for p in paths if p.resolve() != own]


def now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def seconds(stamp) -> float | None:
    """A now() stamp as epoch seconds, or None."""
    try:
        return datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=datetime.timezone.utc).timestamp()
    except (TypeError, ValueError):
        return None


def duration(value: float) -> str:
    value = int(value)
    if value >= 3600:
        return f"{value // 3600}h{value % 3600 // 60:02d}m"
    return f"{value // 60}m{value % 60:02d}s" if value >= 60 else f"{value}s"


# Processes

def processes() -> dict[int, tuple[int, str]]:
    """Live pid -> (ppid, start time); the start time tells a reused pid from the holder. Zombies are dead."""
    result = subprocess.run(["ps", "-axo", "pid=,ppid=,stat=,lstart="], capture_output=True, text=True)
    table = {}
    for line in result.stdout.splitlines():
        parts = line.split(None, 3)
        if len(parts) == 4 and parts[0].isdigit() and parts[1].isdigit() and not parts[2].startswith("Z"):
            table[int(parts[0])] = (int(parts[1]), parts[3].strip())
    return table


def ancestors(table: dict, pid: int) -> set[int]:
    found = set()
    while pid in table and pid not in found and pid > 1:
        found.add(pid)
        pid = table[pid][0]
    return found


def alive(entry: dict, table: dict) -> bool:
    process = table.get(entry.get("pid"))
    return process is not None and entry.get("start") in ("", process[1])


# Memory

def memory_short() -> str | None:
    """Why new leases should wait for memory, or None."""
    seam = setting("MEMORY_FILE")  # test seam: "<free swap MB> <pressure level>"
    if seam:
        try:
            free, level = (float(v) for v in Path(seam).read_text().split()[:2])
        except (OSError, ValueError):
            return None
    else:
        free, level = swap_free_mb(), pressure_level()
    floor = float(setting("MIN_FREE_SWAP_MB") or MIN_FREE_SWAP_MB)
    if free is not None and free < floor:
        return f"free swap {free:.0f} MB is under {floor:.0f} MB"
    if level is not None and level > MAX_PRESSURE_LEVEL:
        return f"memory pressure level {level:.0f} (warning or critical)"
    return None


def sysctl(name: str) -> str | None:
    try:
        result = subprocess.run(["sysctl", "-n", name], capture_output=True, text=True, timeout=PS_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def swap_usage(report: str | None = None) -> tuple[float, float] | None:
    """(total, free) swap in MB from `sysctl vm.swapusage`, or None where the host does not report it."""
    found = re.search(r"total = ([\d.]+)([MG]).*?free = ([\d.]+)([MG])",
                      (sysctl("vm.swapusage") or "") if report is None else report)
    if not found:
        return None
    return tuple(float(found[n]) * (1024 if found[n + 1] == "G" else 1) for n in (1, 3))


def swap_free_mb(report: str | None = None) -> float | None:
    """Free swap in MB, or None when there is no swap to run short of: with swap turned off the kernel reports
    0 MB free at all times, and the floor would hold every lease behind the one running."""
    usage = swap_usage(report)
    return usage[1] if usage and usage[0] > 0 else None


def pressure_level() -> float | None:
    value = sysctl("kern.memorystatus_vm_pressure_level")
    return float(value) if value and value.isdigit() else None


# Usage: what a lease's process tree used, and what the machine did meanwhile

def cpu_seconds(text: str) -> float | None:
    """ps `time` ([days-][hours:]minutes:seconds.fraction) as seconds, or None."""
    days, _, rest = text.strip().rpartition("-")
    try:
        value = 0.0
        for part in rest.split(":"):
            value = value * 60 + float(part)
        return value + (int(days) * 86400 if days else 0)
    except ValueError:
        return None


def started_at(lstart: str) -> float | None:
    """A `ps -o lstart` time (C locale) as epoch seconds, or None."""
    try:
        return time.mktime(time.strptime(" ".join(lstart.split()), "%a %b %d %H:%M:%S %Y"))
    except ValueError:
        return None


def usage_table() -> dict[int, tuple[int, str, int, int, float]]:
    """Live pid -> (ppid, start, uid, resident KB, CPU seconds of its own), from one ps over the machine. Raises
    SlotError when ps fails or takes longer than PS_TIMEOUT."""
    try:
        result = subprocess.run(["ps", "-axo", "pid=,ppid=,uid=,rss=,time=,lstart="], capture_output=True,
                                text=True, env={**os.environ, "LC_ALL": "C"}, timeout=PS_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise SlotError(f"ps: {error}") from None
    table = {}
    for line in result.stdout.splitlines():
        parts = line.split(None, 5)
        if len(parts) == 6 and all(p.isdigit() for p in parts[:4]):
            cpu = cpu_seconds(parts[4])
            if cpu is not None:
                table[int(parts[0])] = (int(parts[1]), parts[5].strip(), int(parts[2]), int(parts[3]), cpu)
    return table


def carrying(pids: list[int], lease: str) -> set[int]:
    """Those of `pids` whose environment holds SLOTFATHER_LEASE=<lease>. macOS shows another process's environment
    only for the user's own processes that are not platform binaries; the rest read as not carrying it."""
    if not pids:
        return set()
    try:
        result = subprocess.run(["ps", "-wwE", "-o", "pid=,command=", "-p", ",".join(map(str, pids))],
                                capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"}, timeout=PS_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return set()
    mark = " SLOTFATHER_LEASE=" + lease
    found = set()
    for line in result.stdout.splitlines():
        pid, _, rest = line.strip().partition(" ")
        at = (" " + rest).find(mark)
        tail = (" " + rest)[at + len(mark):] if at >= 0 else None
        if pid.isdigit() and tail is not None and (not tail or tail[0] == " "):
            found.add(int(pid))
    return found


class TreeUsage:
    """CPU and memory of one command's process tree, from snapshots of the process table.

    A process is the lease's while it descends from the command (attached), and stays the lease's after its parent
    exits and launchd adopts it (detached); a child of launchd started during the lease joins it when its
    environment carries the lease (`marked`). CPU time of every process an attached parent reaps reaches the
    command's own rusage at its exit, so it is not summed here; a detached process is reaped by launchd, so its CPU
    is the last sample of its own time. Processes born and gone between two samples outside the attached tree are
    not seen, nor is a child that exits unwaited-for before its parent exits (launchd reaps that zombie). Resident
    memory is the sum over the tree's processes (shared pages count once per process)."""

    def __init__(self, root: int, since: float, marked=None, uid: int | None = None):
        self.root, self.since = root, since
        self.marked = marked or (lambda pids: set())
        self.uid = os.getuid() if uid is None else uid
        self.root_start = None
        self.root_gone = False  # set once wait4 has reaped the command: its pid may then be another process
        self.members = {}  # (pid, start) -> [own CPU seconds at the last sample, attached]
        self.checked = set()  # (pid, start) of launchd children already considered
        self.detached_gone = 0.0
        self.processes = self.samples = 0
        self.rss_peak = 0  # KB
        self.rss_area = self.span = 0.0  # KB x seconds, seconds
        self.last = None  # (moment, resident KB) of the previous sample

    def candidates(self, table: dict) -> list[int]:
        """Children of launchd started during the lease that have not been considered yet; each is returned once,
        for `marked` to say whether it carries the lease."""
        fresh = []
        for pid, row in table.items():
            key = (pid, row[1])
            if row[0] == 1 and row[2] == self.uid and key not in self.members and key not in self.checked:
                self.checked.add(key)
                begun = started_at(row[1])
                if begun is not None and begun >= self.since - 1:
                    fresh.append(pid)
        return fresh

    def observe(self, moment: float, table: dict, adopted: set[int] | None = None) -> None:
        """Takes in one process table. `adopted` are the candidates() of this table that carry the lease; without
        it observe asks `marked` itself."""
        if adopted is None:
            fresh = self.candidates(table)
            adopted = self.marked(fresh) if fresh else set()
        for key in list(self.members):
            row = table.get(key[0])
            if row is None or row[1] != key[1]:
                cpu, attached = self.members.pop(key)
                if not attached:
                    self.detached_gone += cpu
        children = {}
        for pid, row in table.items():
            children.setdefault(row[0], []).append(pid)

        def tree(roots) -> set[int]:
            found, stack = set(), [p for p in roots if p in table]
            while stack:
                pid = stack.pop()
                if pid not in found:
                    found.add(pid)
                    stack.extend(children.get(pid, ()))
            return found

        if self.root_start is None and self.root in table and not self.root_gone:
            self.root_start = table[self.root][1]
        attached = set() if self.root_gone or self.root not in table or table[self.root][1] != self.root_start \
            else tree([self.root])
        adopted = {pid for pid in adopted if pid in table}
        detached = tree([pid for pid, _ in self.members if pid not in attached] + list(adopted)) - attached
        resident = 0
        for pid in attached | detached:
            row = table[pid]
            key = (pid, row[1])
            if key not in self.members:
                self.processes += 1
            self.members[key] = [row[4], pid in attached]
            resident += row[3]
        if self.last is not None:
            self.rss_area += self.last[1] * (moment - self.last[0])
            self.span += moment - self.last[0]
        self.last = (moment, resident)
        self.rss_peak = max(self.rss_peak, resident)
        self.samples += 1

    def detached(self) -> float:
        """CPU seconds of processes that left the attached tree: gone, and still running at the last sample."""
        return self.detached_gone + sum(cpu for cpu, attached in self.members.values() if not attached)

    def result(self, reaped_cpu: float, reaped_peak_kb: int = 0, wall: float | None = None) -> dict:
        """Usage for the history, once the command has exited and the last sample was taken after its exit:
        `reaped_cpu` and `reaped_peak_kb` come from the command's rusage."""
        detached = self.detached()
        mean = self.rss_area / self.span if self.span > 0 else (self.last[1] if self.last else 0)
        found = {"cpu": round(reaped_cpu + detached, 2), "cpu_detached": round(detached, 2),
                 "rss_peak_mb": round(max(self.rss_peak, reaped_peak_kb) / 1024, 1),
                 "rss_mean_mb": round(mean / 1024, 1), "processes": self.processes, "samples": self.samples}
        if wall is not None:
            found["wall"] = round(wall, 2)
        return found


class Watch(threading.Thread):
    """The holder's sampler: looks at the command's tree, first after SAMPLE_FIRST seconds and then half as long
    again each time up to SLOTFATHER_SAMPLE_MAX, and samples the machine when no holder has lately. A fault here
    never reaches the lease: the history then lacks what could not be measured."""

    def __init__(self, usage: TreeUsage, directory: Path):
        super().__init__(daemon=True, name="slotfather-watch")
        self.usage, self.directory = usage, directory
        try:
            self.most = max(0.05, float(setting("SAMPLE_MAX") or SAMPLE_MAX))
        except ValueError:
            self.most = SAMPLE_MAX
        self.stopped = threading.Event()
        self.lock = threading.Lock()

    def observe(self) -> None:
        """One look at the tree. The ps calls run outside the lock, so finish() never waits on a slow ps for it."""
        moment, table = time.time(), usage_table()
        with self.lock:
            fresh = self.usage.candidates(table)
        adopted = self.usage.marked(fresh) if fresh else set()
        with self.lock:
            self.usage.observe(moment, table, adopted)

    def look(self) -> None:
        with contextlib.suppress(Exception):
            self.observe()
        with contextlib.suppress(Exception):
            sample_machine(self.directory)

    def run(self) -> None:
        # Signals for the holder (forwarded to its command) must interrupt the holder's wait4, not this thread.
        with contextlib.suppress(AttributeError, OSError, ValueError):
            signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGHUP, signal.SIGINT})
        interval = min(SAMPLE_FIRST, self.most)
        while not self.stopped.wait(interval):
            self.look()
            interval = min(interval * 1.5, self.most)

    def finish(self, rusage, wall: float) -> dict | None:
        """Stops sampling, takes the last look (after the command exited) and returns the usage. Waits at most
        WATCH_JOIN seconds for the sampler, and skips the last look when it is still stuck: the release goes on."""
        self.usage.root_gone = True
        self.stopped.set()
        self.join(timeout=WATCH_JOIN)
        if not self.is_alive():
            with contextlib.suppress(Exception):
                self.observe()
        if rusage is None or not self.lock.acquire(timeout=WATCH_JOIN):
            return None
        try:
            peak = rusage.ru_maxrss // 1024 if sys.platform == "darwin" else rusage.ru_maxrss  # bytes on macOS
            return self.usage.result(rusage.ru_utime + rusage.ru_stime, peak, wall)
        except Exception:  # noqa: BLE001 - measuring must never cost the lease its release
            return None
        finally:
            self.lock.release()


_host_port = None


def cpu_ticks() -> list[int] | None:
    """Cumulative CPU ticks of the whole machine: [user, system, idle, nice], or None where unavailable."""
    global _host_port
    if sys.platform == "darwin":
        try:
            import ctypes
            libc = ctypes.CDLL("/usr/lib/libSystem.B.dylib")
            if _host_port is None:
                libc.mach_host_self.restype = ctypes.c_uint
                _host_port = libc.mach_host_self()
            counts, size = (ctypes.c_uint * 4)(), ctypes.c_uint(4)
            if libc.host_statistics(_host_port, 3, counts, ctypes.byref(size)) == 0:  # HOST_CPU_LOAD_INFO
                return list(counts)
        except (OSError, AttributeError):
            return None
        return None
    with contextlib.suppress(OSError, ValueError):
        fields = Path("/proc/stat").read_text().split("\n", 1)[0].split()[1:]
        user, nice, system, idle = (int(v) for v in fields[:4])
        return [user, system, idle + sum(int(v) for v in fields[4:5]), nice]  # iowait counts as idle
    return None


def machine_facts(directory: Path) -> dict:
    """One machine sample: load, cumulative CPU ticks (busy is the change between two samples), memory pressure,
    swap and the slots held."""
    held = [e for _, e in entries(directory) if e.get("state") == "held"]
    swap = swap_usage()
    level = pressure_level()
    free = sysctl("kern.memorystatus_level")
    item = {"v": MACHINE_VERSION, "t": now(), "at": round(time.time(), 2),
            "load": [round(v, 2) for v in os.getloadavg()], "ticks": cpu_ticks(), "cores": cores(),
            "pressure": level, "memory_free_pct": int(free) if free and free.isdigit() else None,
            "swap_total_mb": None if swap is None else round(swap[0]),
            "swap_free_mb": None if swap is None else round(swap[1]),
            "held": sum(e["count"] for e in held), "leases": len(held)}
    with contextlib.suppress(SlotError):
        item["capacity"] = total()
    return item


def sample_machine(directory: Path) -> bool:
    """Appends a machine sample unless one was taken in the last SLOTFATHER_MACHINE_EVERY seconds; holders share
    the duty through machine.jsonl's age and a lock of its own, never the queue's."""
    path = directory / "machine.jsonl"
    try:
        every = float(setting("MACHINE_EVERY") or MACHINE_EVERY)
    except ValueError:
        every = MACHINE_EVERY

    def due() -> bool:
        try:
            return time.time() - path.stat().st_mtime >= every
        except FileNotFoundError:
            return True
    if not due():
        return False
    with open(directory / ".machine.lock", "a") as handle:
        try:
            fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return False
        if not due():
            return False
        append_bounded(path, json.dumps(machine_facts(directory)) + "\n", MACHINE_MAX)
        return True


# Queue

@contextlib.contextmanager
def locked(directory: Path):
    (directory / "queue").mkdir(parents=True, exist_ok=True)
    with open(directory / ".lock", "a") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def entries(directory: Path) -> list[tuple[Path, dict]]:
    found = []
    for path in sorted((directory / "queue").glob("*.json")):
        try:
            entry = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(entry, dict) and isinstance(entry.get("count"), int):
            found.append((path, entry))
    return found


def write(path: Path, entry: dict) -> None:
    pending = path.with_name(path.name + ".pending")
    pending.write_text(json.dumps(entry) + "\n")
    pending.replace(path)


def reap(directory: Path, table: dict) -> list[tuple[Path, dict]]:
    """Live entries in queue order; removes those whose holder exited or crashed."""
    live = []
    for path, entry in entries(directory):
        if alive(entry, table):
            live.append((path, entry))
        else:
            path.unlink(missing_ok=True)
            log(directory, f"reaped {entry.get('state')} lease of {entry.get('count')} for "
                           f"{entry.get('label')} (pid {entry.get('pid')} exited)")
            record(directory, entry, "reaped")
    return live


def record(directory: Path, entry: dict, outcome: str, status: int | None = None, usage: dict | None = None) -> None:
    """Add a request that left the queue to history.jsonl: released (it ran), left (it gave up waiting) or reaped
    (its holder died), with what its process tree used where the holder measured it. Callers hold the queue lock."""
    ended = time.time()
    queued, granted = seconds(entry.get("since")), seconds(entry.get("granted"))
    item = {"v": HISTORY_VERSION, "label": entry.get("label"), "cmd": entry.get("cmd"), "cwd": entry.get("cwd"),
            "count": entry.get("count"), "pid": entry.get("pid"), "queued": entry.get("since"),
            "granted": entry.get("granted"), "ended": now(), "outcome": outcome,
            "waited": None if queued is None else round((granted or ended) - queued),
            "ran": None if granted is None else round(ended - granted), "status": status}
    with contextlib.suppress(SlotError, OSError):
        item.update(cores=cores(), capacity=total())
    item.update(usage or {})
    with contextlib.suppress(OSError):
        append_bounded(directory / "history.jsonl", json.dumps(item) + "\n", HISTORY_MAX)


def append_bounded(path: Path, line: str, limit: int) -> None:
    """Append a line; past `limit` bytes the file becomes <name>.1, replacing the previous one, so at most two
    files' worth stays. Readers read <name>.1 first, then <name>."""
    fd = os.open(path, os.O_RDWR | os.O_APPEND | os.O_CREAT, 0o644)
    try:
        size = os.fstat(fd).st_size
        # A torn earlier write (a holder killed mid-line) must not swallow this line: start it on a line of its own.
        prefix = b"\n" if size and os.pread(fd, 1, size - 1) != b"\n" else b""
        os.write(fd, prefix + line.encode("utf-8"))  # one write, at the end even with other appenders
    finally:
        os.close(fd)
    if path.stat().st_size > limit:
        path.replace(path.with_name(path.name + ".1"))


def objects(lines) -> list[dict]:
    """The JSON objects among lines; lines that do not parse (a torn write, a foreign line) are skipped."""
    found = []
    for line in lines:
        with contextlib.suppress(ValueError, UnicodeDecodeError):
            item = json.loads(line)
            if isinstance(item, dict):
                found.append(item)
    return found


def journal(path: Path):
    """The JSON objects of a bounded file and its rotated predecessor, oldest first."""
    for part in (path.with_name(path.name + ".1"), path):
        try:
            data = part.read_bytes()
        except FileNotFoundError:
            continue
        yield from objects(data.splitlines())


def tail_objects(path: Path, limit: int) -> list[dict]:
    """The last `limit` JSON objects of one file, read backwards from its end in blocks."""
    try:
        handle = open(path, "rb")
    except FileNotFoundError:
        return []
    with handle:
        end = handle.seek(0, os.SEEK_END)
        block, data = 65536, b""
        while True:
            start = max(0, end - block)
            handle.seek(start)
            data = handle.read(end - start)
            lines = data.splitlines()
            found = objects(lines[1:] if start else lines)  # the first line of a block may be cut
            if len(found) >= limit or not start:
                return found[-limit:]
            block *= 4


def history_items(directory: Path | None = None) -> list[dict]:
    """Every request in history.jsonl (and its rotated part), oldest first. Version-1 lines read as they are: they
    lack "v" and the usage fields."""
    return list(journal((directory or state_dir()) / "history.jsonl"))


def history_lines(limit: int, directory: Path | None = None) -> list[str]:
    """The last `limit` requests that left the queue (every one for 0), oldest first. The rotated part is read only
    when the current file holds fewer."""
    path = (directory or state_dir()) / "history.jsonl"
    if limit:
        items = tail_objects(path, limit)
        if len(items) < limit:
            items = tail_objects(path.with_name(path.name + ".1"), limit - len(items)) + items
    else:
        items = list(journal(path))
    found = []
    for item in items:
        ended = seconds(item.get("ended"))
        when = time.strftime("%m-%d %H:%M", time.localtime(ended)) if ended is not None else "?"
        waited = "?" if item.get("waited") is None else duration(item["waited"])
        ran = "" if item.get("ran") is None else f" ran {duration(item['ran'])}"
        status = "" if item.get("status") is None else f" exit {item['status']}"
        used = ""
        if isinstance(item.get("cpu"), (int, float)):
            wall = item.get("wall") or item.get("ran")
            cores_used = f"{item['cpu'] / wall:.1f} cores" if wall else f"{item['cpu']:.0f} s CPU"
            used = f" used {cores_used}, {item.get('rss_peak_mb', 0):.0f} MB"
        found.append(f"{when} {item.get('outcome')}: {item.get('count')} slot(s) {item.get('label')} waited "
                     f"{waited}{ran}{status}{used} cmd={item.get('cmd')}")
    return found


def legacy_holders(table: dict) -> list[tuple[Path, dict, int]]:
    """Held leases with a live holder in the earlier queues: (path, entry, slots here). Read only: their own
    clients reap them."""
    found = []
    for directory in legacy_dirs():
        for path, entry in entries(directory):
            if entry.get("state") == "held" and alive(entry, table):
                found.append((path, entry, min(total(), math.ceil(entry["count"] * total() / LEGACY_TOTAL))))
    return found


def legacy_used(table: dict) -> int:
    return sum(count for _, _, count in legacy_holders(table))


def kind(command: str | None) -> str:
    """The kind of check a command is: its program's name and first argument; a comma list counts its items, a path
    keeps its last part, an option keeps its name, and a short option value follows it."""
    words = [w for w in (command or "").split()]
    while words and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[0]):
        words.pop(0)  # VAR=value before the program
    if not words:
        return "?"
    found = [os.path.basename(words[0]) or words[0]]
    rest = words[1:]
    if rest:
        first = rest[0]
        if first.startswith("-"):
            found.append(first.split("=", 1)[0])
            value = rest[1] if len(rest) > 1 and "=" not in first else ""
            if value and not value.startswith("-"):
                if "," in value:
                    found.append(f"[{len([v for v in value.split(',') if v])}]")
                elif len(value) <= 40 and "=" not in value:
                    found.append(os.path.basename(value.rstrip("/")) or value)
        elif "," in first:
            found.append(f"[{len([v for v in first.split(',') if v])}]")
        else:
            found.append(os.path.basename(first.rstrip("/")) or first)
    return " ".join(found)[:60]


def overtakable(entry: dict, moment: float | None = None) -> bool:
    """Whether later requests that fit may still start before this waiter: it has waited less than the window."""
    queued = seconds(entry.get("since"))
    return queued is not None and (time.time() if moment is None else moment) - queued < overtake_window()


# Ordering: which waiters start now (#643)

def queue_order() -> str:
    """SLOTFATHER_QUEUE: backfill (the default) or window, the order before #643; anything else is window."""
    value = setting("QUEUE") or "backfill"
    return value if value in QUEUE_ORDERS else "window"


def number(name: str, default: float, low: float = 0.0) -> float:
    """SLOTFATHER_<name> as a number of at least `low`; unset or not a number gives the default."""
    try:
        return max(low, float(setting(name) or default))
    except ValueError:
        return default


def family(label: str | None) -> str:
    """A label without its ticket or agent id: lane-636-measure and lane-640-smoke-skip are both lane,
    agent-a17b708a4e705e421 is agent, sid-kit-wt-646 is sid-kit-wt."""
    words = (label or "").split("-")
    for at, word in enumerate(words):
        if at and any(c.isdigit() for c in word):
            return "-".join(words[:at])
    return label or ""


class Estimates:
    """Run times of finished requests, for how long a request will run: the median of the last ESTIMATE_RUNS runs
    of the closest kind that ran before (same label and command kind; same command kind; same label family and
    command kind with a check list of about the same size; that kind under any label; same label; same family), or
    None for a request like nothing before."""

    def __init__(self, runs=()):
        self.runs = {}
        for label, command, ran in runs:
            self.add(label, command, ran)

    @staticmethod
    def keys(label: str | None, command: str | None) -> list[tuple]:
        found = []
        if command:
            what = kind(command)
            # A list of checks keeps its size within a factor of two: 140 checks are not 4.
            rough = re.sub(r" \[(\d+)\]$", lambda m: f" [~{int(m[1]).bit_length()}]", what)
            found += [("label", label, what), ("kind", what), ("family", family(label), rough), ("rough", rough)]
        return found + [("label", label), ("family", family(label))]

    def add(self, label: str | None, command: str | None, ran: float) -> None:
        for key in self.keys(label, command):
            recent = self.runs.setdefault(key, [])
            recent.append(float(ran))
            del recent[:-ESTIMATE_RUNS]

    def of(self, label: str | None, command: str | None) -> float | None:
        for key in self.keys(label, command):
            recent = self.runs.get(key)
            if recent:
                ordered = sorted(recent)
                middle = len(ordered) // 2
                return ordered[middle] if len(ordered) % 2 else (ordered[middle - 1] + ordered[middle]) / 2
        return None


def history_estimates(directory: Path) -> Estimates:
    """Estimates from the end of history.jsonl (ESTIMATE_BYTES of it): every request that was granted and ran.
    Requests whose holder ran a slotfather that records no history (before #635) are not in it."""
    path = directory / "history.jsonl"
    runs = []
    for part in (path.with_name(path.name + ".1"), path):
        try:
            with open(part, "rb") as handle:
                end = handle.seek(0, os.SEEK_END)
                handle.seek(max(0, end - ESTIMATE_BYTES))
                lines = handle.read().splitlines()
        except FileNotFoundError:
            continue
        for item in objects(lines[1:] if end > ESTIMATE_BYTES else lines):
            if isinstance(item.get("ran"), (int, float)) and item.get("granted"):
                runs.append((item.get("label"), item.get("cmd"), item["ran"]))
    return Estimates(runs)


class Plan:
    """What grant() does to the waiters: `grants` start now, in queue order; `reason` says why the first that does
    not start waits; `head` is the waiter the others must not delay, expected to start at `start` (epoch seconds)."""

    def __init__(self):
        self.grants, self.reason, self.head, self.start = [], None, None, None


def reserve(found: Plan, held: list[dict], slots: int, used: int, moment: float, estimate, fallback: float,
            overrun: float) -> int:
    """Sets the head's expected start: when, by the expected ends of what holds slots (`held` and the grants so
    far), enough slots will be free for it. Returns the slots free then that the head will not need."""
    ends = []
    for entry in held + found.grants:
        granted = seconds(entry.get("granted"))
        ran = 0.0 if granted is None else max(0.0, moment - granted)
        run = estimate(entry)
        run = fallback if run is None else run
        ends.append((moment + max(run - ran, overrun * ran), entry["count"]))
    have, found.start = max(0, slots - used), moment
    for end, count in sorted(ends):
        if have >= found.head["count"]:
            break
        have, found.start = have + count, end
    if have < found.head["count"]:  # slots held in an earlier queue, whose end is unknown: nothing passes
        found.start = moment
    return max(0, have - found.head["count"])


def plan(waiters: list[dict], held: list[dict], slots: int, moment: float, order: str | None = None,
         estimate=None, other: int = 0, reserve_head: bool = False) -> Plan:
    """Which of `waiters` (queue order) start now beside `held` (entries; `other` slots more held without one) on
    `slots` slots at epoch `moment`. `estimate(entry)` is its expected run in seconds or None (unknown).

    window: in arrival order; a waiter that does not fit lets later ones that fit start first until it has waited
    SLOTFATHER_OVERTAKE_WINDOW, then holds back everyone behind it.

    backfill: the same within the window; the first waiter past it that does not fit is the head. Its start is
    reserved: the moment enough slots will be free, from the expected ends of the held leases. A later waiter
    that fits starts before the head only when SLOTFATHER_BACKFILL_SAFETY times its expected run ends by then
    and the head has waited less than SLOTFATHER_BACKFILL_LIMIT, or when it takes only slots the head will not
    need at that moment. An unknown run counts SLOTFATHER_BACKFILL_FALLBACK seconds; a held lease past its
    expected run is expected to run on for SLOTFATHER_BACKFILL_OVERRUN times what it has run so far. The head's
    start is worked out only when a request behind it fits, or with `reserve_head`."""
    order = order or queue_order()
    estimate = estimate or (lambda entry: None)
    window = overtake_window()
    fallback = number("BACKFILL_FALLBACK", BACKFILL_FALLBACK)
    safety = number("BACKFILL_SAFETY", BACKFILL_SAFETY, 1.0)
    overrun = number("BACKFILL_OVERRUN", BACKFILL_OVERRUN)
    limit = number("BACKFILL_LIMIT", BACKFILL_LIMIT)
    found = Plan()
    used = sum(e["count"] for e in held) + other
    extra = None  # slots free at the head's start that it does not need; reserved once a request behind it fits
    for entry in waiters:
        free = max(0, slots - used)
        if found.head is not None:
            if entry["count"] > free:
                continue
            if extra is None:
                extra = reserve(found, held, slots, used, moment, estimate, fallback, overrun)
            deadline = (seconds(found.head.get("since")) or moment) + limit if limit else math.inf
            run = estimate(entry)
            run = fallback if run is None else run
            if moment + run * safety <= min(found.start, deadline):
                pass  # ends before the head can start, and before it has waited the limit
            elif entry["count"] <= extra:
                extra -= entry["count"]
            else:
                continue
            found.grants.append(entry)
            used += entry["count"]
            continue
        if entry["count"] <= free:
            found.grants.append(entry)
            used += entry["count"]
            continue
        queued = seconds(entry.get("since"))
        passable = queued is not None and moment - queued < window
        if order != "backfill":
            if not passable:
                found.reason = found.reason or f"{free} of {slots} slots free"
                return found
        elif not passable:
            found.head = entry
            found.reason = (f"{free} of {slots} slots free; {entry['label']} is next, and a later request that fits "
                            f"starts first only if it ends before {entry['label']} can start")
            if reserve_head:
                extra = reserve(found, held, slots, used, moment, estimate, fallback, overrun)
            continue
        until = time.strftime("%H:%M:%S", time.localtime(queued + window))
        found.reason = found.reason or (f"{free} of {slots} slots free; requests that fit may pass "
                                        f"{entry['label']} until {until}")
    return found


def room(waiters: list[dict], free: int, held: list[dict] | None = None, estimate=None, other: int = 0) -> int:
    """The slots a new request of unknown run gets at once behind `waiters` with `free` slots unheld, as grant()
    admits it. Without `held` (the entries holding slots; `other` slots more held without one), the window
    order's answer."""
    slots = free + sum(e["count"] for e in held or ()) + other
    moment = time.time()
    order = queue_order() if held is not None else "window"
    for count in range(free, 0, -1):
        probe = {"count": count, "label": "", "cmd": "", "since": now()}
        if any(entry is probe for entry in plan(waiters + [probe], held or [], slots, moment, order, estimate,
                                                         other).grants):
            return count
    return 0


_estimates = {}  # history files' (size, mtime) -> Estimates, so a waiter's repeated looks read the history once


def estimator(directory: Path):
    """estimate(entry) from the history, read only when plan() first asks (a head waits and a later request fits),
    and again only once the history has changed."""
    def estimate(entry: dict) -> float | None:
        path = directory / "history.jsonl"
        stamp = []
        for part in (path.with_name(path.name + ".1"), path):
            with contextlib.suppress(OSError):
                info = part.stat()
                stamp.append((str(part), info.st_size, info.st_mtime_ns))
        stamp = tuple(stamp)
        if stamp not in _estimates:
            _estimates.clear()
            _estimates[stamp] = history_estimates(directory)
        return _estimates[stamp].of(entry.get("label"), entry.get("cmd"))
    return estimate


def grant(directory: Path, table: dict) -> str | None:
    """Grant the waiters plan() starts, in queue order, while memory allows. Returns why the first that does not
    start still waits."""
    live = reap(directory, table)
    held = [e for _, e in live if e["state"] == "held"]
    waiters = [e for _, e in live if e["state"] != "held"]
    paths = {id(e): path for path, e in live}
    found = plan(waiters, held, total(), time.time(), estimate=estimator(directory), other=legacy_used(table))
    used = sum(e["count"] for e in held) + legacy_used(table)
    short = None
    for entry in found.grants:
        if used:
            short = short or memory_short()
            if short:
                return short
        entry.update(state="held", granted=now())
        write(paths[id(entry)], entry)
        used += entry["count"]
        log(directory, f"granted {entry['count']} to {entry['label']} (pid {entry['pid']})")
    return found.reason


def log(directory: Path, message: str) -> None:
    with contextlib.suppress(OSError):
        with open(directory / "queue.log", "a", encoding="utf-8") as handle:
            handle.write(f"{now()} {message}\n")


def snapshot(directory: Path | None = None) -> tuple[list[dict], list[tuple[Path, dict, int]], dict]:
    """The live queue entries, the earlier queues' holders and the process table."""
    directory = directory or state_dir()
    table = processes()
    with locked(directory):
        live = [entry for _, entry in reap(directory, table)]
    return live, legacy_holders(table), table


def status_lines(directory: Path | None = None) -> list[str]:
    live, legacy, _ = snapshot(directory)
    lines = [f"{e['state']}: {e['count']} slot(s) {e['label']} pid={e['pid']} since={e['since']} cmd={e['cmd']}"
             for e in live]
    lines += [f"legacy: {count} slot(s) {e.get('label')} pid={e.get('pid')} (earlier queue {path.parent.parent})"
              for path, e, count in legacy]
    used = sum(e["count"] for e in live if e["state"] == "held") + sum(count for _, _, count in legacy)
    return lines + [f"{used} of {total()} slots held"]


def available(directory: Path | None = None) -> int:
    """How many slots a new request of unknown run would get at once: the free ones less what waiters take first,
    or none while a waiter past the overtaking window holds back everyone behind it (backfill: unless the
    request would end before that waiter can start)."""
    directory = directory or state_dir()
    live, legacy, _ = snapshot(directory)
    held = [e for e in live if e["state"] == "held"]
    other = sum(count for _, _, count in legacy)
    return room([e for e in live if e["state"] != "held"], max(0, total() - sum(e["count"] for e in held) - other),
                held, estimator(directory), other)


# Sizing

def size(maximum: int, cores: int, total: int, averages: tuple[float, float, float], held: int,
         waiting: bool = False, exclusive: bool = False) -> dict:
    """A job count for work that runs beside `held` leased slots (or after them, when `exclusive`) under load
    `averages` (1, 5 and 15 minutes) that include processes taking no lease. The module docstring has the formula."""
    per_slot = cores / total
    load1, load5, load15 = averages
    load = min(load1, load5)
    unleased = max(0.0, load - held * per_slot)
    busy = unleased + (0.0 if exclusive else held * per_slot)
    capacity = max(0, math.floor((cores - busy) / per_slot + 0.5))
    free = total if exclusive else 0 if waiting else max(0, total - held)
    jobs = max(1, min(maximum, capacity, free))
    return {"jobs": jobs, "maximum": maximum, "exclusive": exclusive, "cores": cores, "total": total,
            "cores_per_slot": round(per_slot, 2), "held": held, "waiting": waiting, "free": free,
            "load": round(load, 2), "load1": round(load1, 2), "load5": round(load5, 2), "load15": round(load15, 2),
            "unleased_load": round(unleased, 2), "capacity": capacity}


def advise(maximum: int | None = None, exclusive: bool = False, cores_now: int | None = None,
           averages: tuple[float, float, float] | None = None) -> dict:
    """size() for the queue as it is now: slots held by others (the caller's own lease is not one) and
    whether a request waits."""
    live, legacy, table = snapshot()
    mine = inherited_lease(table)
    holders = [e for e in live if e["state"] == "held" and not (mine and e["pid"] == mine[1]["pid"])]
    other = sum(count for path, e, count in legacy if not (mine and path == mine[0]))
    held = sum(e["count"] for e in holders) + other
    slots = total()
    waiters = [e for e in live if e["state"] != "held"]
    waiting = bool(waiters) and room(waiters, max(0, slots - held), holders, estimator(state_dir()), other) == 0
    return size(maximum or slots, cores_now or cores(), slots, averages or loads(), min(held, slots), waiting,
                exclusive)


# Leases

class Lease:
    """A held lease, an inherited one, or none (bypass). Release it once the work has finished."""

    def __init__(self, count: int, path: Path | None = None, inherited: bool = False):
        self.count, self.path, self.inherited = count, path, inherited
        self.status = None  # the command's exit status, for the history, where the holder knows it
        self.usage = None  # what the command's process tree used (TreeUsage.result), where the holder measured it

    def environment(self) -> dict[str, str]:
        if self.path is None:
            return {}
        env = {}
        for prefix in LEASE_ENV_PREFIXES:
            env.update({prefix + "LEASE": str(self.path), prefix + "COUNT": str(self.count)})
        return env

    def release(self) -> None:
        if self.path is not None and not self.inherited:
            directory = self.path.parent.parent
            with locked(directory):
                try:
                    entry = json.loads(self.path.read_text())
                except (OSError, ValueError):
                    entry = None
                self.path.unlink(missing_ok=True)
                log(directory, f"released {self.count} ({self.path.name})")
                if isinstance(entry, dict):
                    record(directory, entry, "released" if entry.get("state") == "held" else "left", self.status,
                           self.usage)
                # Hand the slots on now: waiters look at the queue less often the longer they wait.
                with contextlib.suppress(SlotError, OSError):
                    grant(directory, processes())
            self.path = None

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.release()


def inherited_lease(table: dict) -> tuple[Path, dict, int] | None:
    """The held lease this process runs under, here or in an earlier queue: (path, entry, slots here)."""
    mine = ancestors(table, os.getpid())
    own = setting("LEASE")
    for path, entry in entries(state_dir()):
        if entry.get("state") == "held" and alive(entry, table) and (own == str(path) or entry["pid"] in mine):
            return path, entry, entry["count"]
    for path, entry, count in legacy_holders(table):
        if own == str(path) or entry["pid"] in mine:
            return path, entry, count
    return None


def inherited(table: dict) -> Lease | None:
    found = inherited_lease(table)
    if found is None:
        return None
    path, _, count = found
    # A lease in an earlier queue is honoured but not handed on: nested runs find its holder among their ancestors.
    return Lease(count, path if path.parent.parent == state_dir() else None, inherited=True)


def policy() -> str:
    value = setting("POLICY") or "normal"
    if value not in POLICIES:
        raise SlotError(f"invalid SLOTFATHER_POLICY {value!r}: use {', '.join(POLICIES)}")
    return value


def acquire(count: int | str, label: str, command: str = "", out=sys.stderr, wait: float | None = None,
            note: str = "") -> Lease:
    """Wait in the queue for `count` slots (at most the total); the lease is held by this process until released.
    Raises SlotTimeout, having left the queue, when `wait` seconds pass first. `note` follows the first word that
    the request waits."""
    if count != "all" and (type(count) is not int or count < 1):
        raise SlotError("count must be a positive integer or all")
    if policy() == "bypass":
        return Lease(total())
    directory = state_dir()
    table = processes()
    found = inherited(table)
    if found:
        return found
    poll = float(setting("POLL") or 2)
    poll_max = max(poll, float(setting("POLL_MAX") or POLL_MAX))
    me = os.getpid()
    try:
        cwd = os.getcwd()
    except OSError:
        cwd = ""
    with locked(directory):
        # Admission and capacity changes share this lock; resolve all only now.
        count = total() if count == "all" else min(count, total())
        sequence_file = directory / "sequence"
        try:
            sequence = int(sequence_file.read_text() or 0) + 1
        except (OSError, ValueError):
            sequence = 1
        sequence_file.write_text(str(sequence))
        path = directory / "queue" / f"{sequence:010d}-{me}.json"
        write(path, {"pid": me, "start": table.get(me, (0, ""))[1], "count": count, "label": label,
                     "cmd": command, "cwd": cwd, "since": now(), "state": "waiting"})
    lease = Lease(count, path)
    deadline = None if wait is None else time.monotonic() + wait
    # A terminated waiter leaves the queue at once rather than at the next reap.
    main_thread = threading.current_thread() is threading.main_thread()
    previous_term = signal.signal(signal.SIGTERM, terminate) if main_thread else None
    try:
        said, interval, look = None, poll, 0.0
        while True:
            if time.monotonic() >= look:
                # A full look runs ps over the machine under the queue lock. While the reason to wait stays the same,
                # each pause is half as long again, up to poll_max: a release grants at once, so only reaping a
                # crashed holder and memory recovering wait for a look.
                with locked(directory):
                    waiting = grant(directory, processes())
                interval = poll if waiting != said else min(interval * 1.5, poll_max)
                look = time.monotonic() + interval
            try:
                state = json.loads(path.read_text())["state"]  # written whole by rename: no lock needed
            except (OSError, ValueError):
                raise SlotError("the lease vanished from the queue") from None
            if state == "held":
                if said:
                    print(f"slot: granted {count} slot(s) to {label}", file=out, flush=True)
                return lease
            if deadline is not None and time.monotonic() >= deadline:
                raise SlotTimeout(f"no {count} slot(s) within {wait:g} s: {waiting or 'earlier requests first'}")
            if waiting != said:
                print(f"slot: {label} waits for {count} slot(s): {waiting or 'earlier requests first'}",
                      file=out, flush=True)
                for line in status_lines(directory):
                    print(f"  {line}", file=out, flush=True)
                if note and said is None:
                    print(f"slot: {note}", file=out, flush=True)
                said = waiting
            pause = min(poll, max(0.0, look - time.monotonic()))
            time.sleep(pause if deadline is None else max(0.0, min(pause, deadline - time.monotonic())))
    except BaseException:
        lease.release()
        raise
    finally:
        if previous_term is not None:
            signal.signal(signal.SIGTERM, previous_term)


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


def run(count: int | str, label: str, argv: list[str], wait: float | None = None) -> int:
    """Run argv under a lease of `count` slots; the command's exit status."""
    try:
        background = policy() == "background"
        lease = acquire(count, label, " ".join(argv), wait=wait, note=ALL_NOTE if count == "all" else "")
    except SlotTimeout as error:
        print(f"slot: {label}: {error}", file=sys.stderr)
        return TIMED_OUT
    except KeyboardInterrupt:
        return 130
    except SystemExit as stop:
        return int(stop.code or 1)
    with lease:
        if background:
            prefix = ["/usr/sbin/taskpolicy", "-b", "/usr/bin/nice", "-n", "10"] if os.access(
                "/usr/sbin/taskpolicy", os.X_OK) else ["/usr/bin/nice", "-n", "10"]
            argv = prefix + argv
        try:
            child = subprocess.Popen(argv, env={**os.environ, **lease.environment()})
        except OSError as error:
            print(f"slot: {error}", file=sys.stderr)
            return 127
        began = time.monotonic()
        watch = None
        if lease.path is not None and not lease.inherited:
            marker = str(lease.path)
            watch = Watch(TreeUsage(child.pid, time.time() - 1, lambda pids: carrying(pids, marker)),
                          lease.path.parent.parent)
            with contextlib.suppress(RuntimeError):
                watch.start()
        reaped = []

        def forward(signum, _frame):
            # os.kill rather than child.send_signal, which polls and could reap the child before wait4 sees it;
            # until wait4 returns the child (a zombie at worst) keeps its pid.
            if not reaped:
                with contextlib.suppress(ProcessLookupError):
                    os.kill(child.pid, signum)
        # The terminal sends SIGINT to the child's process group itself; the lease outlives the child.
        signal.signal(signal.SIGINT, signal.SIG_IGN)
        for signum in (signal.SIGTERM, signal.SIGHUP):
            signal.signal(signum, forward)
        try:
            _, raw, rusage = os.wait4(child.pid, 0)  # the rusage holds every descendant reaped inside the tree
            status = os.waitstatus_to_exitcode(raw)
        except ChildProcessError:
            status, rusage = child.wait(), None
        reaped.append(True)
        if watch is not None:
            watch.usage.root_gone = True  # before any later look: the pid may be reused from now on
        child.returncode = status
        if watch is not None and watch.is_alive():
            lease.usage = watch.finish(rusage, time.monotonic() - began)
        lease.status = 128 - status if status < 0 else status
    return lease.status


# Command line

def companion(name: str, argv: list[str], title: str) -> int:
    """Runs slotfather-<name> from beside this file with this interpreter: the dashboard's and the statistics' code
    never loads with the queue's, and a fault in it cannot reach admission."""
    path = Path(__file__).resolve().with_name(f"slotfather-{name}")
    if not path.is_file():
        raise SlotError(f"{title} is not installed beside slotfather: {path}")
    os.execv(sys.executable, [sys.executable, str(path), *argv])
    return 0  # not reached


def dashboard(argv: list[str]) -> int:
    return companion("dashboard", argv, "the dashboard")



USAGE = ("usage: slotfather                     (in a terminal: the live dashboard)\n"
         "       slotfather run [-n N|all] [--label L] [--wait SECONDS] [--] COMMAND...\n"
         "       slotfather status | available | history [N] | advise [--max N] [--exclusive]\n"
         "       slotfather stats [--since WHEN] [--label GLOB] [--by both|label|kind] [--top N] [--json]\n"
         "       slotfather slots [N|reset]\n"
         "       slotfather dashboard [--interval SECONDS] | dashboard --once [--width N] [--height N] [--color]")


def parse_count(value: str) -> int:
    if value == "all":
        return total()
    if not value.isdigit() or int(value) < 1:
        raise SlotError(f"-n takes a positive count or all, not {value!r}")
    return int(value)


def run_command(argv: list[str]) -> int:
    count, label, wait = 1, os.path.basename(os.getcwd()), None
    while argv:
        if argv[0] in ("-n", "--slots") and len(argv) > 1:
            count, argv = ("all" if argv[1] == "all" else parse_count(argv[1])), argv[2:]
        elif argv[0] in ("-l", "--label") and len(argv) > 1:
            label, argv = argv[1], argv[2:]
        elif argv[0] == "--wait" and len(argv) > 1:
            try:
                wait = float(argv[1])
            except ValueError:
                raise SlotError(f"--wait takes seconds, not {argv[1]!r}") from None
            argv = argv[2:]
        elif argv[0] == "--":
            argv = argv[1:]
            break
        elif argv[0].startswith("-"):
            raise SlotError(f"unknown option {argv[0]}")
        else:
            break
    if not argv:
        raise SlotError("no command to run")
    return run(count, label, argv, wait)


def advise_command(argv: list[str]) -> int:
    maximum, exclusive = None, False
    while argv:
        if argv[0] == "--max" and len(argv) > 1:
            maximum, argv = parse_count(argv[1]), argv[2:]
        elif argv[0] == "--exclusive":
            exclusive, argv = True, argv[1:]
        else:
            raise SlotError(f"unknown advise option {argv[0]}")
    print(json.dumps(advise(maximum, exclusive), sort_keys=True))
    return 0


def slots_command(argv: list[str]) -> int:
    if len(argv) > 1 or (argv and argv[0] != "reset" and
                         (not argv[0].isascii() or not argv[0].isdigit() or int(argv[0]) < 1)):
        raise SlotError("slots takes a positive integer or reset")
    directory = state_dir()
    with locked(directory):
        if argv:
            table = processes()
            live = reap(directory, table)
            legacy_live = any(alive(entry, table) for old in legacy_dirs() for _, entry in entries(old))
            if live or legacy_live:
                raise SlotError("queue is busy; capacity can change only after every holder and waiter leaves")
            path = directory / "capacity.json"
            try:
                if argv[0] == "reset":
                    path.unlink(missing_ok=True)
                else:
                    write(path, {"slots": int(argv[0])})
            except OSError as error:
                raise SlotError(f"cannot save capacity: {error}") from None
        value, saved = capacity()
    print(f"{value} slots ({'saved' if saved else 'automatic'})")
    return 0


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    command, rest = (argv[0], argv[1:]) if argv else ("", [])
    # A person typing just `slotfather` wants to see the queue; a script or agent without a terminal gets the usage.
    if not argv and sys.stdin.isatty() and sys.stdout.isatty():
        command = "dashboard"
    try:
        if command == "run":
            return run_command(rest)
        if command == "slots":
            return slots_command(rest)
        if command == "status" and not rest:
            print("\n".join(status_lines()))
            return 0
        if command == "history" and (not rest or (len(rest) == 1 and rest[0].isdigit())):
            print("\n".join(history_lines(int(rest[0]) if rest else 20)))
            return 0
        if command == "available" and not rest:
            print(available())
            return 0
        if command == "advise":
            return advise_command(rest)
        if command == "dashboard":
            return dashboard(rest)
        if command == "stats":
            return companion("stats", rest, "slotfather-stats")
        if command in ("-h", "--help", "help"):
            print(__doc__)
            return 0
    except SlotError as error:
        print(f"slotfather: {error}\n{USAGE}", file=sys.stderr)
        return 2
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())
