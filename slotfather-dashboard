#!/usr/bin/env python3
"""Run the Slotfather dashboard from a checkout or installed release."""
import sys
from pathlib import Path

if sys.version_info < (3, 9):
    sys.exit("slotfather needs Python 3.9 or later; reinstall with a newer Python: /path/to/python3 install.py")
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))
from slotfather.dashboard import main

if __name__ == "__main__":
    sys.exit(main())
